// 为每个物种匹配相关文章
const speciesWithArticles = speciesGroups.map(group => ({
  ...group,
  species: group.species.map(sp => {
    const articles = allPosts
      .filter(p => p.data.tags.some(t => t === sp.filterTag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return { ...sp, articles };
  })
}));

// 统计
const totalSpecies = speciesGroups.reduce((sum, g) => sum + g.species.length, 0);
const beginnerSpecies = speciesGroups.reduce((sum, g) => sum + g.species.filter(s => s.beginner).length, 0);
---

<Layout title="物种大全 | 异宠指南" description={`${totalSpecies}种异宠详解：守宫、蛇、蜥蜴、蛙、龟全覆盖。新手推荐、饲养数据、推荐品种一网打尽。`}>

<section class="species-page">
  <!-- Hero -->
  <header class="species-hero">
    <div class="hero-bg">
      <div class="hero-pattern"></div>
    </div>
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge">🦎 异宠百科</span>
        <h1>物种大全</h1>
        <p class="hero-sub">
          共收录 <strong>{totalSpecies}</strong> 种异宠，其中 <strong>{beginnerSpecies}</strong> 种适合新手入门。<br/>
          不知道该养什么？先看完这个页面再说。
        </p>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-num">{speciesGroups.length}</span>
            <span class="stat-label">大类</span>
          </div>
          <div class="stat">
            <span class="stat-num">{totalSpecies}</span>
            <span class="stat-label">物种</span>
          </div>
          <div class="stat">
            <span class="stat-num">{beginnerSpecies}</span>
            <span class="stat-label">新手友好</span>
          </div>
          <div class="stat">
            <span class="stat-num">{allPosts.length}</span>
            <span class="stat-label">篇教程</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Data Visualization Chart -->
  <section class="chart-section">
    <div class="container">
      <SpeciesChart />
    </div>
  </section>

  <!-- Quick Compare Table -->
  <section class="quick-compare">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">快速对比</span>
        <h2>一眼看懂各物种的核心差异</h2>
      </div>
      <div class="table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>物种</th>
              <th>难度</th>
              <th>体长</th>
              <th>寿命</th>
              <th>温度</th>
              <th>湿度</th>
              <th>食物</th>
              <th>新手推荐</th>
            </tr>
          </thead>
          <tbody>
            {speciesGroups.map(group => group.species.map(sp => (
              <tr>
                <td class="td-name">
                  <strong>{sp.name}</strong>
                  <br/><small>{sp.latin}</small>
                </td>
                <td class="td-center">{sp.difficulty}</td>
                <td>{sp.size}</td>
                <td>{sp.lifespan}</td>
                <td>{sp.temp}</td>
                <td>{sp.humidity}</td>
                <td>{sp.diet}</td>
                <td class="td-center">
                  <span class={`recommend-badge ${sp.beginner ? 'beginner' : 'advanced'}`}>
                    {sp.beginner ? '✅ 推荐' : '⚡ 进阶'}
                  </span>
                </td>
              </tr>
            )))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Species Detail Cards by Group -->
  <div class="species-content">
    {speciesWithArticles.map(group => (
      <section class="species-group" id={group.name}>
        <div class="container">
          <div class="group-header" style={`--group-color: ${group.color}`}>
            <div class="group-header-left">
              <span class="group-emoji">{group.emoji}</span>
              <div class="group-info">
                <h2 class="group-name">{group.name}</h2>
                <p class="group-intro">{group.intro}</p>
              </div>
            </div>
            <span class="group-count">{group.species.length} 种</span>
          </div>

          <div class="species-grid">
            {group.species.map(sp => (
              <div class="species-card" style={`--card-accent: ${sp.cardColor}`}>
                <div class="species-card-top">
                  <div class="species-name-row">
                    <h3 class="species-name">{sp.name}</h3>
                    {sp.beginner && <span class="beginner-badge">新手推荐</span>}
                  </div>
                  <p class="species-latin">{sp.latin}</p>
                </div>

                <p class="species-desc">{sp.desc}</p>

                <!-- 数据网格 -->
                <div class="data-grid">
                  <div class="data-item">
                    <span class="data-icon">📏</span>
                    <div><span class="data-label">体长</span><span class="data-value">{sp.size}</span></div>
                  </div>
                  <div class="data-item">
                    <span class="data-icon">⏳</span>
                    <div><span class="data-label">寿命</span><span class="data-value">{sp.lifespan}</span></div>
                  </div>
                  <div class="data-item">
                    <span class="data-icon">🌡️</span>
                    <div><span class="data-label">温度</span><span class="data-value">{sp.temp}</span></div>
                  </div>
                  <div class="data-item">
                    <span class="data-icon">💧</span>
                    <div><span class="data-label">湿度</span><span class="data-value">{sp.humidity}</span></div>
                  </div>
                  <div class="data-item full">
                    <span class="data-icon">🏠</span>
                    <div><span class="data-label">饲养箱</span><span class="data-value">{sp.enclosure}</span></div>
                  </div>
                  <div class="data-item full">
                    <span class="data-icon">🍽️</span>
                    <div><span class="data-label">食物</span><span class="data-value">{sp.diet}</span></div>
                  </div>
                </div>

                <div class="species-temperament">
                  <span class="temperament-label">性格：</span>{sp.temperament}
                </div>

                <!-- 关联文章 -->
                {sp.articles.length > 0 && (
                  <div class="species-links">
                    <span class="links-label">📖 相关教程（{sp.articles.length}篇）</span>
                    <div class="links-list">
                      {sp.articles.map(article => (
                        <a href={`/blog/${article.slug}.html`} class="article-link">
                          {article.data.title}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
                {sp.articles.length === 0 && (
                  <div class="species-links-empty">📝 教程撰写中，敬请期待</div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- 还在纠结？ -->
    <section class="starter-guide">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">选择困难？</span>
          <h2>还在纠结选什么？</h2>
          <p class="section-desc">按你的条件，找到最适合的异宠</p>
        </div>

        <div class="guide-cards">
          <div class="guide-card recommend">
            <div class="guide-icon">🏆</div>
            <h3>最省心入门</h3>
            <p>不想养虫子？睫角守宫吃果泥就行。<br/>不想管温湿度？豹纹守宫最耐操。<br/>不想每天喂？角蛙一周喂一次。</p>
            <span class="guide-tag">豹纹守宫 · 睫角守宫 · 角蛙</span>
          </div>
          <div class="guide-card">
            <div class="guide-icon">🤝</div>
            <h3>最亲人互动</h3>
            <p>想要会认你的宠物？鬃狮蜥是"蜥蜴界的金毛"。<br/>想要温顺可上手？玉米蛇从来不咬人。</p>
            <span class="guide-tag">鬃狮蜥 · 玉米蛇</span>
          </div>
          <div class="guide-card">
            <div class="guide-icon">🏠</div>
            <h3>小空间之选</h3>
            <p>桌面就能养？瘤尾守宫用30cm小缸。<br/>宿舍也能藏？角蛙用一个收纳盒就行。</p>
            <span class="guide-tag">角蛙 · 瘤尾守宫 · 豹纹守宫</span>
          </div>
          <div class="guide-card">
            <div class="guide-icon">💪</div>
            <h3>颜值担当</h3>
            <p>追求视觉震撼？巨人守宫是守宫界的坦克。<br/>喜欢色彩斑斓？球蟒五千种品系随便挑。</p>
            <span class="guide-tag">巨人守宫 · 球蟒 · 番茄蛙</span>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <div class="species-cta">
      <div class="container">
        <p>确定目标了吗？从新手指南开始——</p>
        <a href="/blog.html" class="btn btn-primary btn-lg">
          浏览全部教程
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

</Layout>

