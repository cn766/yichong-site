              <path d="M10.098 20.323c-3.977.391-7.414-1.406-7.672-4.02-.259-2.609 2.759-5.047 6.74-5.441 3.979-.394 7.413 1.404 7.671 4.018.259 2.6-2.759 5.049-6.737 5.439l-.002.004zM9.05 17.219c-.384.616-1.208.884-1.829.602-.612-.279-.793-.991-.406-1.593.379-.595 1.176-.861 1.793-.601.622.263.82.972.442 1.592zm1.27-1.627c-.141.237-.449.353-.689.253-.236-.09-.313-.361-.177-.586.138-.227.436-.346.672-.24.239.09.315.36.18.573h.014zm.176-2.719c-1.893-.493-4.033.45-4.857 2.118-.836 1.704-.026 3.591 1.886 4.21 1.983.64 4.318-.341 5.132-2.179.8-1.793-.201-3.642-2.161-4.149zm7.563-1.224c-.346-.105-.579-.18-.405-.649.389-1.061.429-1.978.007-2.635-.789-1.223-2.946-1.158-5.413-.033l.001.001c0-.001-.576.253-.429-.204.283-.9.241-1.652-.199-2.085-.997-.979-3.649.039-5.925 2.273-1.699 1.67-2.687 3.44-2.687 4.973 0 2.929 3.754 4.715 7.425 4.715 4.812 0 8.015-2.799 8.015-5.022 0-1.344-1.135-2.107-1.79-2.334zm3.029-5.163c-1.016-1.127-2.519-1.751-4.229-1.751-.445 0-.803.359-.803.803 0 .443.358.801.803.801 1.196 0 2.255.429 3.024 1.239.77.81 1.174 1.9 1.174 3.153 0 .443.359.802.803.802.443 0 .801-.359.801-.802 0-1.583-.563-2.964-1.573-4.245zm-1.659 2.258c-.531-.59-1.318-.917-2.215-.917-.444 0-.802.358-.802.802 0 .443.358.801.802.801.472 0 .888.168 1.185.499.297.33.453.778.453 1.331 0 .443.359.802.803.802.443 0 .801-.359.801-.802 0-.92-.326-1.726-.947-2.376l-.08-.14z"/>
